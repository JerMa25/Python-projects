import math
import matplotlib.pyplot as plt
import numpy as np
from Schema_de_Horner import horner_Newton
from interpolation import piL

def f1(x):
    return 1/(1 + x**2)

def f2(x):
    return 1/(1 + math.exp(-x**2))

#Declaration of variables
P,a,f=[],[],[]
n=int(input("Entrer le nombre de pts d'interpolation: "))

#Tableau des points d'interpolation dans l'intervalle [-25,25]
a = np.linspace(-25,25,n)
"""the method above is equivalent to this:
for i in range(n):
    a.append(-25+(50*i)/(n-1))"""

choix = int(input("Quel fonction souhaitiez vous implémenter?\n1. f(x) = 1/(1 + x²)\n2. f(x) = 1/(1 + exp(-x²))\n"))
if choix == 1:
    #Tableau des images des points de a par f1
    for i in range(n):
        f.append(f1(a[i]))
else:
    # Tableau des images des points de a par f2
    for i in range(n):
        f.append(f2(a[i]))

#Tableau des coefficients du piL sous forme de Newton
tab = piL(a,f)

#Tableau des images des points de a par piL
for i in range(n):
    P.append(horner_Newton(n-1,a[i],a,tab))

plt.plot(a, P, label="y = piL(x)", color="blue", linestyle="-", linewidth=2)
plt.plot(a, f, label="y = f(x)", color="red", linestyle="--", linewidth=2)

# Ajouter des étiquettes et un titre
plt.xlabel("Axe X")
plt.ylabel("Axe Y")
if choix == 1:
    plt.title("Graphe de y = 1/(1 + x²)")
else:
    plt.title("Graphe de y = 1/(1 + exp(-x²))")

# Ajouter une légende
plt.legend()

# Afficher le graphe
plt.show()
